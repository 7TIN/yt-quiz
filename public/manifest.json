{
  "manifest_version": 3,
  "name": "Learning Loop for YouTube",
  "short_name": "Learning Loop",
  "description": "Turn YouTube videos into an interactive learning experience: chapters, quizzes, hints and Q&A. Uses your own Gemini API key; nothing leaves the browser except calls to Google's API.",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["transcript-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
