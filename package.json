{
  "name": "learning-loop-youtube",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && vite build --config vite.config.content.ts && vite build --config vite.config.bridge.ts",
    "check:panel": "node scripts/panel-check.mjs",
    "check:transcript": "node scripts/transcript-check.mjs",
    "check:sw": "node scripts/sw-check.mjs",
    "check:quiz-live": "node scripts/quiz-live-check.mjs",
    "probe:yt": "node scripts/yt-probe.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
